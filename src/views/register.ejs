<%- include('./partials/header') %>
<section class="auth-page">
    <div class="auth-aside">
        <p class="auth-kicker">KIZUNA RAIL / ACCOUNT</p>
        <h1>Make room for the long way round.</h1>
        <p>Create an account to keep your rail journeys together.</p>
        <div class="auth-route-mark" aria-hidden="true"><span></span><span></span><span></span></div>
    </div>
    <div class="auth-form-panel">
        <p class="auth-overline">START HERE</p>
        <h2>Create your account</h2>
        <% if (error) { %><p class="auth-error" role="alert"><%= error %></p><% } %>
        <form action="/register" method="post" class="auth-form">
            <label for="displayName">Display name</label>
            <input id="displayName" name="displayName" type="text" value="<%= form.displayName %>" autocomplete="name" maxlength="80" required>
            <label for="username">Username</label>
            <input id="username" name="username" type="text" value="<%= form.username %>" autocomplete="username" minlength="3" maxlength="30" pattern="[A-Za-z0-9._-]+" required>
            <label for="email">Email</label>
            <input id="email" name="email" type="email" value="<%= form.email %>" autocomplete="email" required>
            <label for="password">Password</label>
            <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>
            <label for="confirmPassword">Confirm password</label>
            <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128" required>
            <button type="submit">Create account</button>
        </form>
        <p class="auth-switch">Already registered? <a href="/login">Log in</a></p>
    </div>
</section>
<%- include('./partials/footer') %>